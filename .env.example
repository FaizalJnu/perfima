# Copy to .env and adjust. docker compose reads .env automatically.
POSTGRES_USER=perfima
POSTGRES_PASSWORD=perfima
POSTGRES_DB=perfima
POSTGRES_PORT=5432
API_PORT=8000

# Used to sign login tokens, set it to a long random string
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=300

JAEGER_UI_PORT=16686
OTLP_HTTP_PORT=4318

# When running the API outside docker against the compose services
# DATABASE_URL=postgresql+psycopg://perfima:perfima@localhost:5432/perfima
# Tracing is off unless this is set
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=perfima
